{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "enabledManagers": ["github-actions", "pip-compile", "pre-commit"],
  "github-actions": { "pinDigests": true },
  "pip-compile": {
    "managerFilePatterns": ["/^requirements-(attestation|ci|build|fuzz)\\.txt$/"]
  },
  "pre-commit": { "enabled": true },
  "constraints": { "uv": "==0.13.0", "python": "==3.11" },
  "lockFileMaintenance": { "enabled": true },
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 3,
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Age filtering is supported for Actions and hook revisions",
      "matchManagers": ["github-actions", "pre-commit"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Keep Python sources and their shared hash locks together",
      "matchManagers": ["pip-compile"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "Python non-major dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "GitHub Actions non-major dependencies"
    },
    {
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Pre-commit non-major dependencies"
    }
  ]
}
